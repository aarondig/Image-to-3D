# Tripo3D API Configuration
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
TRIPO_API_KEY=your_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Image Upload Limits
MAX_IMAGE_BYTES=3000000

# ⚠️ DEVELOPMENT MODE - DISABLE BEFORE DEPLOYING TO PRODUCTION ⚠️
# Set to 'true' to bypass credit limits during development
# MUST be set to 'false' or removed before production deployment
DEV_MODE_BYPASS_LIMITS=false

# 🎭 MOCK API MODE - For UI Testing Without API Calls
# Set to 'true' to use fake 3D models instead of calling Tripo API
# Perfect for testing UI/UX without consuming API credits
# Returns instant success with a sample cube model
MOCK_API_RESPONSES=false

# 📦 RESULT CACHING - Reuse Results for Identical Images
# Client-side caching is always enabled (uses localStorage)
# Server-side caching requires Vercel KV (optional, see docs)
# ENABLE_SERVER_CACHE=false
# CACHE_TTL_DAYS=7

# Vercel KV Configuration (Optional - for persistent server-side cache)
# Sign up at https://vercel.com/docs/storage/vercel-kv
# KV_REST_API_URL=your_kv_url
# KV_REST_API_TOKEN=your_kv_token
